# ─────────────────────────────────────────────────────────────────────────────
# MapleLaunch configuration. Copy to apps/api/.env for local runs.
# Local development needs NONE of the external keys: it uses an embedded
# Postgres, built-in auth, local file storage and an offline document reader.
# ─────────────────────────────────────────────────────────────────────────────

# Database: "pgserver" starts an embedded Postgres 16 (no Docker needed).
# Production: Supabase → Project → Connect → "Session pooler" URI (port 5432).
DATABASE_URL=pgserver

# Public URLs (bare hostnames are fine; https:// is added automatically)
PUBLIC_API_URL=http://localhost:8000          # where providers send webhooks
PROVIDERS_BASE_URL=http://localhost:8001      # mock provider service
WEB_ORIGIN=http://localhost:3000              # CORS (comma-separated)

# Auth: local | supabase
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=                          # only for legacy HS256 projects
DEMO_PASSWORD=MapleLaunch@2026

# Storage: local | supabase (creates a private "documents" bucket)
STORAGE_MODE=local

# Secrets (any random strings; 32-byte base64 recommended for the keys)
APP_SECRET=change-me
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
WEBHOOK_SECRET=dev-webhook-secret
PROVIDER_ADMIN_TOKEN=dev-provider-admin-token

# LLMs (free tiers). Without keys, extraction uses the offline sample reader and
# decisions use the deterministic rules engine.
GEMINI_API_KEY=
# Provider order, and Gemini models tried in turn (each has its own free daily quota)
LLM_ORDER=groq,gemini
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-2.5-flash
GROQ_API_KEY=
# Optional extra Groq keys, comma-separated; used in turn while one is rate-limited
GROQ_API_KEYS=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Email (optional). Without a verified domain Resend only delivers to your own address.
RESEND_API_KEY=
# Send every notification email to this address instead (Resend's free plan only delivers to the account owner)
EMAIL_REDIRECT_TO=
EMAIL_FROM=MapleLaunch <onboarding@resend.dev>

# Frontend (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
